# Required public production configuration.
# Copy this file to .env.production.local and use verified real values.
FIT3_SITE_URL=

# Temporary launch switch. Set to true only while the legal/support pages are
# unavailable; this removes those footer links and the support email from the
# generated site. Set to false (or remove it) for the final public release.
FIT3_HIDE_LEGAL_LINKS=false

FIT3_SUPPORT_EMAIL=
FIT3_PRIVACY_URL=
FIT3_TERMS_URL=
FIT3_APP_STORE_ID=
FIT3_APP_STORE_URL=

# Optional deep link used by Apple's Smart App Banner.
FIT3_APP_ARGUMENT=
