{
  "name": "fitcoachlanding",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "generate:pages": "node --env-file-if-exists=.env.production.local scripts/generate-localized-pages.mjs",
    "validate:config": "node --env-file-if-exists=.env.production.local -e \"import('./scripts/production-config.mjs')\"",
    "verify:dist": "node --env-file-if-exists=.env.production.local scripts/verify-production-build.mjs",
    "predev": "npm run generate:pages",
    "dev": "vite",
    "build": "npm run generate:pages && tsc && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "verify": "npm run build && npm run verify:dist && npm audit --audit-level=high"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.1.5"
  }
}
